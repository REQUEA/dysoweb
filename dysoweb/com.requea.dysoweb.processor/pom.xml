<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <parent>
        <artifactId>dysoweb</artifactId>
        <groupId>com.requea.dysoweb</groupId>
		<version>2.0.1-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.requea.dysoweb</groupId>
    <artifactId>com.requea.dysoweb.processor</artifactId>
    <packaging>bundle</packaging>
    <name>Requea Dysoweb Processor</name>
    <version>2.0.1-SNAPSHOT</version>
    <url>http://www.requea.com</url>
    <dependencies>
		<dependency>
			<groupId>jakarta.servlet</groupId>
			<artifactId>jakarta.servlet-api</artifactId>
			<version>6.0.0</version>
            <scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>jakarta.servlet.jsp</groupId>
			<artifactId>jakarta.servlet.jsp-api</artifactId>
			<version>3.1.1</version>
			<scope>provided</scope>
		</dependency>
        <dependency>
			<groupId>org.osgi</groupId>
            <artifactId>org.osgi.core</artifactId>
            <scope>provided</scope>
        </dependency>
		<dependency>
			<groupId>org.apache.felix</groupId>
			<artifactId>org.apache.felix.framework</artifactId>
            <scope>provided</scope>
		</dependency>
        <dependency>
            <groupId>com.requea.dysoweb</groupId>
            <artifactId>dysoweb-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.requea.dysoweb</groupId>
            <artifactId>com.requea.dysoweb.api</artifactId>
            <scope>provided</scope>
        </dependency>
		<!-- Track B: modern Tomcat 10.1 Jasper replaces the vendored Tomcat-7 fork.
		     janino/commons-compiler dropped (ecj is now the JSP compiler). The servlet/
		     jsp APIs stay provided (resolved via system.packages), so exclude Tomcat's
		     own copies to avoid duplicate jakarta.servlet* on the classpath. -->
		<dependency>
			<groupId>org.apache.tomcat</groupId>
			<artifactId>tomcat-jasper</artifactId>
			<version>10.1.56</version>
			<exclusions>
				<exclusion>
					<groupId>org.apache.tomcat</groupId>
					<artifactId>tomcat-servlet-api</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.apache.tomcat</groupId>
					<artifactId>tomcat-jsp-api</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.apache.tomcat</groupId>
			<artifactId>tomcat-util</artifactId>
			<version>10.1.56</version>
		</dependency>
		<dependency>
			<groupId>org.apache.tomcat</groupId>
			<artifactId>tomcat-util-scan</artifactId>
			<version>10.1.56</version>
		</dependency>
		<dependency>
			<groupId>org.apache.tomcat</groupId>
			<artifactId>tomcat-api</artifactId>
			<version>10.1.56</version>
		</dependency>
		<dependency>
			<groupId>org.apache.tomcat</groupId>
			<artifactId>tomcat-juli</artifactId>
			<version>10.1.56</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.jdt</groupId>
			<artifactId>ecj</artifactId>
			<version>3.33.0</version>
		</dependency>
        <dependency>
            <groupId>requeabuild</groupId>
            <artifactId>naming-resources</artifactId>
            <version>5.5.20</version>
        </dependency>
		<dependency>
			<groupId>org.apache.tomcat</groupId>
			<artifactId>tomcat-el-api</artifactId>
			<version>10.1.56</version>
		</dependency>
		<dependency>
			<groupId>org.apache.tomcat</groupId>
			<artifactId>tomcat-jasper-el</artifactId>
			<version>10.1.56</version>
		</dependency>
        <dependency>
		    <groupId>commons-logging</groupId>
		    <artifactId>commons-logging</artifactId>
		    <version>1.2</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
			    <version>5.1.9</version>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <!-- Tomcat 10.1 el/servlet jars declare osgi.contract Provide-Capability;
                             bnd would add matching Require-Capability the Felix system bundle can't
                             satisfy. EL/servlet APIs resolve via system.packages, so disable contracts. -->
                        <_contract>off</_contract>
                        <Bundle-Name>Requea Dysoweb Processor</Bundle-Name>
                        <Bundle-SymbolicName>${project.artifactId}</Bundle-SymbolicName>
                        <Bundle-Vendor>Requea.com</Bundle-Vendor>
                        <Bundle-Activator>com.requea.dysoweb.bundle.Activator</Bundle-Activator>
                        <Export-Package>
							com.requea.dysoweb.util.xml;version="${dysowebVersion}",
							<!-- generated JSP servlets extend org.apache.jasper.runtime.HttpJspBase
							     etc.; web bundles must be able to import it from the processor -->
							org.apache.jasper.runtime
                        </Export-Package>
                        <!-- Only our own source is inlined. The modern engine packages
                             (org.apache.jasper/tomcat/el, org.eclipse.jdt) ship as whole jars on
                             the Bundle-ClassPath via Embed-Dependency; listing them here too would
                             inline a second, loose copy. -->
                        <Private-Package>
							com.requea.dysoweb.*
                        </Private-Package>
                        <Import-Package>
                        	com.requea.webenv,
                        	com.requea.dysoweb;version="${dysowebVersion}",
							jakarta.servlet;version="6.0.0",
							jakarta.servlet.descriptor;version="6.0.0",
							jakarta.servlet.http;version="6.0.0",
							jakarta.servlet.jsp;version="3.1.0",
							jakarta.servlet.jsp.resources;version="3.1.0",
							jakarta.servlet.jsp.tagext;version="3.1.0",
							jakarta.servlet.jsp.el;version="3.1.0",
							jakarta.el;version="5.0.0",
							javax.naming.*,
                        	javax.xml.*,
                        	jakarta.el.*,
                        	org.w3c.dom,
                        	org.xml.sax.*,
							org.osgi.framework.*,
							<!-- Unused by the ecj (JDT) compile path; mark optional so the bundle
							     resolves without Ant / JSR-199 tools / Graal on the classpath. -->
							org.apache.tools.ant.*;resolution:=optional,
							javax.tools;resolution:=optional,
							javax.lang.model.*;resolution:=optional,
							javax.annotation.processing;resolution:=optional,
							org.graalvm.nativeimage;resolution:=optional,
							sun.misc;resolution:=optional,
							<!-- the processor inlines dysoweb-core's bootstrap classes (DysowebServlet,
							     AutoActivator) via com.requea.dysoweb.*; their Felix launcher refs are
							     never used inside the bundle, so don't import them -->
							!org.apache.felix.*,
							<!-- let bnd resolve modern Jasper's remaining external refs -->
							*
                        </Import-Package>
                        <!-- Embed exactly the modern engine + support jars. The servlet/jsp/el
                             APIs stay provided (imported via system.packages), so they are NOT
                             listed here. -->
                        <Embed-Dependency>tomcat-jasper,tomcat-jasper-el,tomcat-util,tomcat-util-scan,tomcat-api,tomcat-juli,ecj,naming-resources,commons-logging;scope=compile|runtime</Embed-Dependency>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
