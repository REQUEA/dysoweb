<?xml version="1.0" encoding="UTF-8"?>
<!-- Track-B Phase-0 spike. STANDALONE (not wired into the sandbox reactor) so it
     cannot affect the main build. Proves modern Jasper compiles a JSP through a
     getResource-backed ServletContext (no DirContext) using ecj. Throwaway. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.requea.dysoweb.spike</groupId>
  <artifactId>jasper-spike</artifactId>
  <version>0.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <tomcat.version>10.1.56</tomcat.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <version>6.0.0</version>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet.jsp</groupId>
      <artifactId>jakarta.servlet.jsp-api</artifactId>
      <version>3.1.1</version>
    </dependency>
    <!-- The engine under test + its runtime, EL, scanning util, and the ecj compiler.
         tomcat-jasper pulls tomcat-jasper-el, tomcat-el-api, tomcat-api,
         tomcat-util, tomcat-util-scan, tomcat-juli and ecj transitively. -->
    <dependency>
      <groupId>org.apache.tomcat</groupId>
      <artifactId>tomcat-jasper</artifactId>
      <version>${tomcat.version}</version>
    </dependency>
    <!-- ecj: the JSP compiler (decided). Pin explicitly in case the jasper POM
         marks it provided/optional. -->
    <dependency>
      <groupId>org.eclipse.jdt</groupId>
      <artifactId>ecj</artifactId>
      <version>3.33.0</version>
    </dependency>
    <!-- OSGi API: TldDiscovery is written against the real org.osgi.framework.Bundle
         so it lifts into the processor unchanged. -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.core</artifactId>
      <version>6.0.0</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>jasper-spike</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <release>21</release>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
